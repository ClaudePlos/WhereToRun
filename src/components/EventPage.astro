---
import Base from '../layouts/Base.astro';
import RaceMap from './RaceMap.astro';
import { useTranslations, localizedPath } from '../lib/i18n.js';
import { formatDateRange, formatMoney, countryName, eventText } from '../lib/events.js';

const { event, lang } = Astro.props;
const t = useTranslations(lang);
const text = eventText(event, lang);
const country = countryName(event.location.countryCode, lang, event.location.country);
const when = formatDateRange(event.date, event.endDate, lang);
const hasIndicativeFee = event.fees.some((fee) => fee.indicative);
const osmUrl = `https://www.openstreetmap.org/?mlat=${event.start.lat}&mlon=${event.start.lon}#map=14/${event.start.lat}/${event.start.lon}`;
const updated = new Intl.DateTimeFormat(lang === 'pl' ? 'pl-PL' : 'en-GB', { dateStyle: 'medium', timeZone: 'UTC' })
  .format(new Date(event.updatedAt));
---

<Base lang={lang} path={`/events/${event.slug}/`} title={event.name} description={text.summary}>
  <article class="wrap event">
    <a class="back" href={localizedPath(lang, '/')}>{t('event.back')}</a>

    <header>
      <div class="tag-row">
        <span class="badge accent">{t(`type.${event.type}`)}</span>
        {event.tags.map((tag) => <span class="badge">{tag}</span>)}
      </div>
      <h1>{event.name}</h1>
      <p class="lede">{text.summary}</p>
    </header>

    <dl class="facts">
      <div>
        <dt>{t('event.date')}</dt>
        <dd>
          <time datetime={event.date}>{when}</time>
          {event.dateStatus === 'estimated' && <p class="note">{t('event.estimated')}</p>}
        </dd>
      </div>
      <div>
        <dt>{t('event.location')}</dt>
        <dd>{event.location.city}{event.location.region ? `, ${event.location.region}` : ''}, {country}</dd>
      </div>
      {event.distances.length > 0 && (
        <div>
          <dt>{t('event.distances')}</dt>
          <dd>{event.distances.join(' · ')}</dd>
        </div>
      )}
      <div>
        <dt>{t('event.updated')}</dt>
        <dd>{updated} <span class="muted">({event.source.id})</span></dd>
      </div>
    </dl>

    <section class="prose">
      <p>{text.description}</p>
    </section>

    <section>
      <h2>{t('event.fees')}</h2>
      {event.fees.length === 0 ? (
        <p class="muted">{t('event.fees.none')}</p>
      ) : (
        <table class="fees">
          <tbody>
            {event.fees.map((fee) => (
              <tr>
                <th scope="row">{fee.label[lang] ?? fee.label.en}</th>
                <td>{fee.indicative ? '≈ ' : ''}{formatMoney(fee.amount, fee.currency, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
      {hasIndicativeFee && <p class="note">{t('event.fees.indicative')}</p>}
    </section>

    <section>
      <h2>{t('event.start')}</h2>
      {event.start.name && <p>{event.start.name}</p>}
      <RaceMap
        points={[{ lat: event.start.lat, lon: event.start.lon, title: event.name, subtitle: event.start.name ?? undefined }]}
        zoom={13}
        height="420px"
        attribution={t('map.attribution')}
      />
      <p class="muted coords">
        {t('event.coords')}: {event.start.lat.toFixed(5)}, {event.start.lon.toFixed(5)} ·
        {' '}<a href={osmUrl} rel="noopener">{t('event.osm')}</a>
      </p>
    </section>

    <section>
      <h2>{t('event.links')}</h2>
      <ul class="links">
        {event.website && (
          <li><a href={event.website} rel="noopener">{t('event.website')}</a></li>
        )}
        {event.registrationUrl && (
          <li><a href={event.registrationUrl} rel="noopener">{t('event.register')}</a></li>
        )}
        {event.links.map((link) => (
          <li><a href={link.url} rel="noopener">{link.label[lang] ?? link.label.en}</a></li>
        ))}
        {event.source.url && (
          <li class="muted"><a href={event.source.url} rel="noopener">{t('event.source')}: {event.source.id}</a></li>
        )}
      </ul>
    </section>
  </article>
</Base>

<style>
  .event { padding: 2rem 0 1rem; max-width: 820px; }
  .back { display: inline-block; margin-bottom: 1.5rem; font-size: 0.9rem; text-decoration: none; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.9rem; }
  .lede { font-size: 1.1rem; color: var(--muted); }
  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem; margin: 2rem 0; padding: 1.25rem;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  }
  .facts dt { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 0.3rem; }
  .facts dd { margin: 0; font-weight: 600; }
  .note { font-size: 0.83rem; color: var(--muted); font-weight: 400; margin: 0.35rem 0 0; }
  .prose p { font-size: 1.03rem; }
  section { margin-top: 2.5rem; }
  .fees { width: 100%; border-collapse: collapse; }
  .fees th, .fees td { text-align: left; padding: 0.6rem 0; border-bottom: 1px solid var(--border); font-weight: 400; }
  .fees td { text-align: right; font-weight: 600; white-space: nowrap; }
  .coords { font-size: 0.85rem; margin-top: 0.6rem; }
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
</style>
